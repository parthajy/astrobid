# ============================================================================
# AstroBid environment variables
# Copy to .env.local for local dev; add the same keys in Vercel/Netlify.
# The app boots without any of these (demo mode) — add them to go live.
# ============================================================================

# --- App --------------------------------------------------------------------
# Public base URL. Locally: http://localhost:3000
# On Vercel you can omit it (VERCEL_URL is used); on Netlify set it to your
# site URL because NEXT_PUBLIC_* values are baked in at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Minimum first bid on an unclaimed day (whole currency units, default 5)
NEXT_PUBLIC_BASE_MIN_BID=5

# Currency shown throughout the UI: USD | INR | EUR | GBP | AUD | CAD | SGD
NEXT_PUBLIC_CURRENCY=USD

# Google Analytics 4 measurement ID (loads only in production builds)
NEXT_PUBLIC_GA_ID=G-LWBNTKQDWZ

# --- Supabase -------------------------------------------------------------------
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Payments ---------------------------------------------------------------
# mock | pledge | dodo | razorpay | lemonsqueezy
# Leave unset to auto-detect from whichever keys are present; else "pledge".
PAYMENTS_PROVIDER=pledge

# Show a "test mode — no real charge" hint in the UI (use with a test-mode gateway key)
PAYMENTS_TEST_MODE=false

# Lemon Squeezy (https://app.lemonsqueezy.com) — test-mode key works today, swap
# for a live key later with no code change. The variant must be "pay what you want".
#   Settings > API           -> LEMONSQUEEZY_API_KEY
#   Store URL / Stores API    -> LEMONSQUEEZY_STORE_ID
#   Product > Variant         -> LEMONSQUEEZY_VARIANT_ID
#   Settings > Webhooks       -> LEMONSQUEEZY_WEBHOOK_SECRET  (endpoint: /api/webhook/lemonsqueezy, event: order_created)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Dodo Payments (merchant of record, global USD) — https://app.dodopayments.com
DODO_API_KEY=
DODO_PRODUCT_ID=          # a product configured as "Pay what you want"
DODO_MODE=test            # test | live
DODO_WEBHOOK_SECRET=      # whsec_... from Developer > Webhooks
# DODO_API_URL=https://test.dodopayments.com
# DODO_CURRENCY=USD
# DODO_DEFAULT_COUNTRY=US

# Razorpay (India / INR) — https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_CURRENCY=INR

# --- Cron -----------------------------------------------------------------------
# Optional shared secret protecting /api/cron/lock (sent as `Authorization: Bearer …`)
CRON_SECRET=
